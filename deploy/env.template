# Generated by the installer. Keep private and backed up: without the FIELD_*
# keys, encrypted patient data can't be read.
HMS_VERSION=__VERSION__
REGISTRY=polynexus
HTTP_PORT=80
HTTPS_PORT=443

DEPLOYMENT_MODE=on_premise
# Identifies this installation; the licence must carry the same ID.
DEPLOYMENT_ID=__DEPLOYMENT_ID__

ALLOWED_HOSTS=__HOSTS__
CORS_ALLOWED_ORIGINS=__ORIGINS__
CSRF_TRUSTED_ORIGINS=__ORIGINS__
# nginx always serves HTTPS and redirects port 80 itself; this is Django's own redirect.
SECURE_SSL_REDIRECT=False

# Reverse-proxy hops in front of the app for client-IP resolution (login
# throttle, lockout, per-account IP allow-list). 1 = the bundled single nginx;
# raise it if a CDN/load-balancer sits ahead of nginx.
NUM_PROXIES=1

# Secret that authenticates the provider webhooks that accept an unauthenticated
# body (telephony call events, inbound WhatsApp/SMS/email). REQUIRED in
# production: without it those webhooks are refused. Append it to the callback
# URL you register with the PBX / messaging provider as ?secret=<value> (or
# send it as the X-Webhook-Secret header). Generate with: openssl rand -hex 32
WEBHOOK_SHARED_SECRET=__WEBHOOK_SECRET__

# Error monitoring (optional): a Sentry-protocol DSN, e.g. a GlitchTip server
# on your network. Events carry no patient data.
SENTRY_DSN=
SENTRY_ENVIRONMENT=on-premise

POSTGRES_DB=hms
POSTGRES_USER=hms
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

SECRET_KEY=__SECRET_KEY__
FIELD_ENCRYPTION_KEY=__FERNET_KEY__
FIELD_ENCRYPTION_KEY_V2=__GCM_KEY__
FIELD_HASH_KEY=__HASH_KEY__

# Nightly backups (database + uploaded files). Point BACKUP_DIR at a NAS or
# external drive, e.g. /mnt/nas/hms-backups (Linux) or D:/hms-backups (Windows).
BACKUP_DIR=./backups
BACKUP_TIME=02:00
BACKUP_KEEP_DAYS=30
# Encrypts every backup (AES-256). Keep a copy of this passphrase OFF the backup
# drive: without it backups cannot be restored. Leave empty only for testing.
BACKUP_PASSPHRASE=

LICENSE_SUPPORT_EMAIL=support@polynexus.in
# Offline by default: integrations stay disabled unless licensed.
WHATSAPP_PROVIDER=stub
TELEPHONY_PROVIDER=stub
ABDM_GATEWAY=stub

# Windows hosts: install.ps1 writes the machine's identity here for the licence fingerprint.
# (Linux hosts read /etc/machine-id and the system UUID directly.)
HOST_MACHINE_ID=__HOST_MACHINE_ID__
HOST_PRODUCT_UUID=__HOST_PRODUCT_UUID__

# Web capacity. Blank = 2 x CPU cores + 1 workers, 2 threads each.
# GUNICORN_WORKERS=9
# GUNICORN_THREADS=2
# Seconds a database connection is reused (0 = new connection per request; use 0 behind PgBouncer).
# DB_CONN_MAX_AGE=60
