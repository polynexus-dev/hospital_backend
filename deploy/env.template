# Generated by the installer. Keep private and backed up: without the FIELD_*
# keys, encrypted patient data can't be read.
HMS_VERSION=__VERSION__
REGISTRY=polynexus
HTTP_PORT=80
HTTPS_PORT=443

DEPLOYMENT_MODE=on_premise
# Identifies this installation; the licence must carry the same ID.
DEPLOYMENT_ID=__DEPLOYMENT_ID__

ALLOWED_HOSTS=__HOSTS__
CORS_ALLOWED_ORIGINS=__ORIGINS__
CSRF_TRUSTED_ORIGINS=__ORIGINS__
# True once certs/tls.crt + certs/tls.key are installed.
SECURE_SSL_REDIRECT=False

POSTGRES_DB=hms
POSTGRES_USER=hms
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

SECRET_KEY=__SECRET_KEY__
FIELD_ENCRYPTION_KEY=__FERNET_KEY__
FIELD_ENCRYPTION_KEY_V2=__GCM_KEY__
FIELD_HASH_KEY=__HASH_KEY__

# Nightly backups (database + uploaded files). Point BACKUP_DIR at a NAS or
# external drive, e.g. /mnt/nas/hms-backups (Linux) or D:/hms-backups (Windows).
BACKUP_DIR=./backups
BACKUP_TIME=02:00
BACKUP_KEEP_DAYS=30

LICENSE_SUPPORT_EMAIL=support@polynexus.in
# Offline by default: integrations stay disabled unless licensed.
WHATSAPP_PROVIDER=stub
TELEPHONY_PROVIDER=stub
ABDM_GATEWAY=stub

# Windows hosts: install.ps1 writes the machine's identity here for the licence fingerprint.
# (Linux hosts read /etc/machine-id and the system UUID directly.)
HOST_MACHINE_ID=__HOST_MACHINE_ID__
HOST_PRODUCT_UUID=__HOST_PRODUCT_UUID__
