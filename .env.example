SECRET_KEY=change-me-to-a-random-secret-in-every-environment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.116

DATABASE_URL=postgres://polynexus:polynexus@localhost:5432/hospital_crm

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Separate logical Redis DB from Celery's broker (0) — backs DRF request
# throttling (see REST_FRAMEWORK settings in config/settings/base.py).
CACHE_URL=redis://localhost:6379/1

# Production only (config/settings/prod.py) — origins the SPA frontend is
# actually served from, so session-authenticated CSRF checks pass; defaults
# to CORS_ALLOWED_ORIGINS if unset.
# CSRF_TRUSTED_ORIGINS=https://app.polynexus.in

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Provider selection: "stub" (default, logs instead of sending) or a
# concrete adapter name once credentials are available.
# WhatsApp: set to "aws" to use AWS End User Messaging Social (real
# implementation in apps.communications.adapters). Also set the three
# WHATSAPP_* values below and make sure AWS credentials are available to
# boto3 (env vars / IAM role) — they are NOT set here.
WHATSAPP_PROVIDER=stub
WHATSAPP_AWS_REGION=ap-south-1
WHATSAPP_ORIGINATION_PHONE_NUMBER_ID=
WHATSAPP_META_API_VERSION=v19.0
# SMS: "msg91" sends through MSG91's Flow API. Every SMS template needs its
# MSG91 (DLT) template id, set per template in Inbox > Templates. Point
# MSG91's "On Report Received" webhook at
# https://<this server>/api/v1/webhooks/msg91/<MSG91_WEBHOOK_TOKEN>/
SMS_PROVIDER=stub
MSG91_AUTH_KEY=
MSG91_WEBHOOK_TOKEN=
# Email: "polymx" sends patient / lead email through polyMX over SMTP.
EMAIL_PROVIDER=stub
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
MESSAGING_FROM_EMAIL=Hospital <no-reply@your-domain.in>
TELEPHONY_PROVIDER=stub
# If TELEPHONY_PROVIDER=hodupbx:
# HODUPBX_BASE_URL=https://pbx.yourhospital.com/hodupbx_api/v1.4
# HODUPBX_TOKEN_ID=your_hodupbx_tenant_token_id
# HODUPBX_TENANT_ID=1000
HIS_CONNECTOR=stub

# Self-hosted Ollama server for the 24x7 assistant's free-text intent
# classifier (apps.communications.llm_router) — point this at your actual
# VM's address; localhost:11434 only works if Ollama runs on the same
# machine as this Django process.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=6

# AI call summaries: a self-hosted Whisper server (OpenAI-compatible
# /v1/audio/transcriptions, e.g. speaches). Leave empty to turn call
# analysis off. Summaries use the Ollama server above.
WHISPER_BASE_URL=
WHISPER_MODEL=Systran/faster-whisper-large-v3
CALL_AI_TIMEOUT_SECONDS=180
CALL_RECORDING_VERIFY_TLS=True

# Online payments fallback for on-premise installs (hospitals normally add
# their own Razorpay keys in Settings > Online payments).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Doctors' Google / Outlook calendars (two-way: appointments in, busy times
# block OPD slots). Create an OAuth client in Google Cloud (Calendar API on)
# and an app registration in Azure (Calendars.ReadWrite, offline_access).
# Redirect URIs to register:
#   <CALENDAR_OAUTH_REDIRECT_BASE>/api/v1/calendar/callback/google/
#   <CALENDAR_OAUTH_REDIRECT_BASE>/api/v1/calendar/callback/microsoft/
# CALENDAR_OAUTH_REDIRECT_BASE defaults to PUBLIC_APP_URL.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common
CALENDAR_OAUTH_REDIRECT_BASE=
