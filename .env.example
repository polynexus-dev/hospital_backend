SECRET_KEY=change-me-to-a-random-secret-in-every-environment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Encrypts Patient.national_id_number / insurance_policy_number at rest
# (apps.core.encryption.EncryptedTextField) — Aadhaar/PAN/insurance data is
# sensitive personal data under the DPDP Act / SPDI Rules. Comma-separated
# list so a key can be rotated by adding a new one without losing the
# ability to decrypt rows written under an old one (first key is used for
# new writes, every key is tried on read). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# config/settings/prod.py refuses to start on the checked-in dev default.
FIELD_ENCRYPTION_KEYS=change-me-generate-a-real-fernet-key-per-environment

# HMAC key backing apps.core.encryption.compute_blind_index() — deterministic
# exact-match lookup for encrypted fields that still need search (e.g.
# PreAuthRequest.policy_number_lookup). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Unlike FIELD_ENCRYPTION_KEYS this is a single key, not a rotatable list —
# changing it invalidates every existing lookup hash at once.
BLIND_INDEX_KEY=change-me-generate-a-real-random-hex-key-per-environment

DATABASE_URL=postgres://polynexus:polynexus@localhost:5432/hospital_crm

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Separate logical Redis DB from Celery's broker (0) — backs DRF request
# throttling (see REST_FRAMEWORK settings in config/settings/base.py).
CACHE_URL=redis://localhost:6379/1

# Production only (config/settings/prod.py) — origins the SPA frontend is
# actually served from, so session-authenticated CSRF checks pass; defaults
# to CORS_ALLOWED_ORIGINS if unset.
# CSRF_TRUSTED_ORIGINS=https://app.polynexus.in

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Provider selection: "stub" (default, logs instead of sending) or a
# concrete adapter name once credentials are available.
# WhatsApp: set to "aws" to use AWS End User Messaging Social (real
# implementation in apps.communications.adapters). Also set the three
# WHATSAPP_* values below and make sure AWS credentials are available to
# boto3 (env vars / IAM role) — they are NOT set here.
WHATSAPP_PROVIDER=stub
WHATSAPP_AWS_REGION=ap-south-1
WHATSAPP_ORIGINATION_PHONE_NUMBER_ID=
WHATSAPP_META_API_VERSION=v19.0
SMS_PROVIDER=stub
EMAIL_PROVIDER=stub
TELEPHONY_PROVIDER=stub
HIS_CONNECTOR=stub

# Self-hosted Ollama (apps.communications.llm_router) — free-text intent
# classification for the 24x7 assistant / inbound WhatsApp auto-reply. No
# API key: point this only at a server on a trusted network, never a
# public one. Leave unset to use the defaults in config/settings/base.py.
OLLAMA_BASE_URL=http://13.235.143.251:11435
OLLAMA_MODEL=llama3.2:3b
