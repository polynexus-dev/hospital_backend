{
	"info": {
		"_postman_id": "c1f8d4e9-9a7c-4a3b-8c2d-1e0f9a8b7c6d",
		"name": "Permission and Role Management",
		"description": "Collection demonstrating how to log in, create a role with a template, assign it to a user, and test permissions.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Login as Admin",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"admin_token\", jsonData.access);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"admin@demo-hospital.example\",\n    \"password\": \"changeme123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/auth/login/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login",
						""
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Create Role (OPD Doctor)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"new_role_id\", jsonData.id);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{admin_token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"OPD Doctor Role\",\n    \"template\": \"doctor\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/roles/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"roles",
						""
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Create/Update User with Role",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{admin_token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"new_doctor@demo-hospital.example\",\n    \"first_name\": \"John\",\n    \"last_name\": \"Doe\",\n    \"role\": {{new_role_id}},\n    \"password\": \"changeme123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/users/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"users",
						""
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Login as New Doctor",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"doctor_token\", jsonData.access);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"new_doctor@demo-hospital.example\",\n    \"password\": \"changeme123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/auth/login/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"auth",
						"login",
						""
					]
				}
			},
			"response": []
		},
		{
			"name": "5. Access Patients API as Doctor",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{doctor_token}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/v1/patients/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"patients",
						""
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000"
		}
	]
}
